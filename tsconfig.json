{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "paths": {
      "@marcelsud/simplebase": ["./src/index.ts"],
      "@marcelsud/simplebase/http/*": ["./src/http/*.ts"],
      "@marcelsud/simplebase/kv/*": ["./src/kv/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "tests/**/*.ts"]
}
