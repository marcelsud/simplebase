{
  "name": "simplebase",
  "version": "0.1.0",
  "description": "Composable backend primitives for Bun and PostgreSQL.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "NOTICE", "README.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test --timeout 20000",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "example": "bun run examples/customer.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelsud/simplebase.git"
  }
}
