{
  "name": "simplebase",
  "version": "0.0.0-prototype",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test --timeout 20000",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "example": "bun run examples/customer.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "bun-types": "1.3.14",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelsud/simplebase.git"
  }
}
